# ฐานข้อมูล
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hr_management"

# Server
PORT=4512

# JWT
JWT_SECRET="your-secret-here"
JWT_EXPIRES_IN=86400

# Seed
SEED_ADMIN_PASSWORD=change-me
SEED_USER_PASSWORD=change-me

# Attendance
WORK_START=08:00
WORK_END=17:00
LATE_GRACE_MINUTES=30

# Leave (จำนวนวันต่อปี)
LEAVE_QUOTA_SICK=30
LEAVE_QUOTA_PERSONAL=6
LEAVE_QUOTA_VACATION=6